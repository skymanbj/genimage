        )
    deadline = time.monotonic() + 180
    while not server_ready():
        if comfy_process.poll() is not None:
            raise RuntimeError("ComfyUI 启动失败：\n" + log_tail(server_log))
        if time.monotonic() >= deadline:
            raise TimeoutError("ComfyUI 启动等待超时：\n" + log_tail(server_log))
        time.sleep(1)
