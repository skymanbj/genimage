cloudflared = shutil.which("cloudflared")
if cloudflared is None:
    binary = ROOT.parent / "cloudflared"
    if not binary.is_file():
        binary_tmp = binary.with_suffix(".download")
        binary_url = (
            "https://github.com/cloudflare/cloudflared/releases/latest/"
            "download/cloudflared-linux-amd64"
        )
        with urllib.request.urlopen(binary_url, timeout=60) as response:
            if response.status != 200:
                raise RuntimeError(f"cloudflared 下载失败：HTTP {response.status}")
            with binary_tmp.open("wb") as output:
                shutil.copyfileobj(response, output)
        with binary_tmp.open("rb") as f:
            if f.read(4) != b"\x7fELF":
                raise RuntimeError("cloudflared 下载内容不是有效的 Linux 可执行文件。")
        binary_tmp.replace(binary)
    binary.chmod(binary.stat().st_mode | 0o111)
    cloudflared = str(binary)

