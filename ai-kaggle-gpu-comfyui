from safetensors import safe_open

def verify_model(path, expected_size, expected_sha256=None):
    path = Path(path)
    if not path.is_file() or path.stat().st_size != expected_size:
        return False
    try:
        if path.suffix == ".gguf":
            with path.open("rb") as f:
                if f.read(4) != b"GGUF":
                    return False
        else:
            with safe_open(str(path), framework="pt", device="cpu") as f:
                if not f.keys():
                    return False
        if expected_sha256:
            digest = hashlib.sha256()
            with path.open("rb") as f:
                for chunk in iter(lambda: f.read(4 * 1024 * 1024), b""):
                    digest.update(chunk)
            if digest.hexdigest() != expected_sha256:
                return False
        return True
    except Exception:
        return False

def download_checked(source_url, target, expected_size, expected_sha256=None):
    target = Path(target)
    target.parent.mkdir(parents=True, exist_ok=True)
    if verify_model(target, expected_size, expected_sha256):
        print(f"✅ 校验通过，保留：{target.name}", flush=True)
        return

    temporary = target.with_name(target.stem + ".download" + target.suffix)
    for attempt in range(1, 4):
        try:
            print(f"📥 下载 {target.name}，第 {attempt}/3 次...", flush=True)
            request = urllib.request.Request(
                source_url, headers={"User-Agent": "ComfyUI-Kaggle-Setup/1.0"}
            )
            with urllib.request.urlopen(request, timeout=60) as response:
                if response.status != 200:
                    raise RuntimeError(f"HTTP {response.status}，未返回完整文件")
                with temporary.open("wb") as output:
                    shutil.copyfileobj(response, output, 4 * 1024 * 1024)

            if not verify_model(temporary, expected_size, expected_sha256):
                actual_size = temporary.stat().st_size if temporary.exists() else 0
                raise RuntimeError(
                    f"大小、结构或 SHA-256 校验失败：实际 {actual_size:,} 字节，"
                    f"预期 {expected_size:,} 字节"
                )
            temporary.replace(target)
            print(f"✅ 下载及校验通过：{target.name}，{expected_size:,} 字节", flush=True)
            return
        except Exception as error:
            print(f"⚠️ 下载失败：{error}", flush=True)
            if attempt == 3:
                raise RuntimeError(f"{target.name} 下载失败，脚本已停止。") from error
            time.sleep(2 * attempt)

